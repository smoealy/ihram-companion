{
  "version": 2,
  "builds": [
    {
      "src": "src/api/askAI.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/askAI",
      "dest": "src/api/askAI.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
